{
  "$defs": {
    "ArmResult": {
      "additionalProperties": false,
      "description": "Measured outcome for one arm at one seed.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "mode": {
          "title": "Mode",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_dir": {
          "title": "Run Dir",
          "type": "string"
        },
        "loss_mode": {
          "title": "Loss Mode",
          "type": "string"
        },
        "divergence": {
          "title": "Divergence",
          "type": "string"
        },
        "selector": {
          "title": "Selector",
          "type": "string"
        },
        "top_k": {
          "title": "Top K",
          "type": "integer"
        },
        "optimizer_steps": {
          "title": "Optimizer Steps",
          "type": "integer"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "integer"
        },
        "tasks": {
          "title": "Tasks",
          "type": "integer"
        },
        "success_rate": {
          "title": "Success Rate",
          "type": "number"
        },
        "avg_turns": {
          "title": "Avg Turns",
          "type": "number"
        },
        "avg_tool_calls": {
          "title": "Avg Tool Calls",
          "type": "number"
        },
        "invalid_tool_call_rate": {
          "title": "Invalid Tool Call Rate",
          "type": "number"
        },
        "generated_tokens_per_task": {
          "title": "Generated Tokens Per Task",
          "type": "number"
        },
        "tokens_per_solved_task": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Per Solved Task"
        },
        "selected_training_tokens": {
          "title": "Selected Training Tokens",
          "type": "integer"
        },
        "teacher_queried_position_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Teacher Queried Position Ratio"
        },
        "cache_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Bytes"
        },
        "cache_compression_ratio": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Compression Ratio"
        },
        "peak_allocated_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Allocated Bytes"
        },
        "peak_reserved_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Reserved Bytes"
        },
        "seconds": {
          "title": "Seconds",
          "type": "number"
        },
        "baseline_success_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Success Rate"
        },
        "measurement_status": {
          "default": "measured",
          "title": "Measurement Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "mode",
        "seed",
        "run_id",
        "run_dir",
        "loss_mode",
        "divergence",
        "selector",
        "top_k",
        "optimizer_steps",
        "policy_version",
        "tasks",
        "success_rate",
        "avg_turns",
        "avg_tool_calls",
        "invalid_tool_call_rate",
        "generated_tokens_per_task",
        "selected_training_tokens",
        "seconds"
      ],
      "title": "ArmResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Full benchmark output, including everything that was held constant.",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "miniverl_version": {
      "title": "Miniverl Version",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "git_commit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Commit"
    },
    "hardware": {
      "additionalProperties": true,
      "title": "Hardware",
      "type": "object"
    },
    "software": {
      "additionalProperties": true,
      "title": "Software",
      "type": "object"
    },
    "controlled": {
      "additionalProperties": true,
      "title": "Controlled",
      "type": "object"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/ArmResult"
      },
      "title": "Arms",
      "type": "array"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    }
  },
  "required": [
    "miniverl_version",
    "name",
    "created_at"
  ],
  "title": "miniVERL benchmark result",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DaoyuanLi2816/mini-verl/main/benchmarks/schema/benchmark-result.schema.json"
}
