{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DaoyuanLi2816/mini-verl/benchmarks/schema/consumer-runtime-profiler.schema.json",
  "title": "miniVERL consumer-runtime profiler summary",
  "type": "object",
  "required": ["schema_version", "name", "code_commit", "profiles"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"const": "consumer-runtime-v1-profiler"},
    "code_commit": {"type": ["string", "null"]},
    "profiles": {
      "type": "object",
      "required": ["shared_backbone_auto"],
      "properties": {
        "shared_backbone_auto": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "calls",
              "self_cpu_time_us",
              "self_device_time_us",
              "self_cpu_memory_bytes",
              "self_device_memory_bytes"
            ],
            "properties": {
              "name": {"type": "string"},
              "calls": {"type": "integer", "minimum": 1},
              "self_cpu_time_us": {"type": "number"},
              "self_device_time_us": {"type": "number"},
              "self_cpu_memory_bytes": {"type": "integer"},
              "self_device_memory_bytes": {"type": "integer"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
